/*
 * base.config
 * Computational resources for each process. These depend on the machine
 * the pipeline runs on, so they are kept apart from modules.config.
 */

process {

    // Hard ceiling for any single task (adjust memory to your machine)
    resourceLimits = [ cpus: 6, memory: '24.GB' ]

    // ---- SRA download ----
    withName: 'SRATOOLS_PREFETCH' {
        conda = null
        cpus     = 1
        maxForks = 6
    }

    withName: 'SRATOOLS_FASTERQDUMP' {
        conda = null
        cpus     = 2
        maxForks = 3
    }

    // ---- Database download ----
    withName: 'BUSCO_DOWNLOAD' {
        conda = null
        cpus   = 1
        memory = '4.GB'
    }

    withName: 'RGI_DOWNLOADDB' {
        conda = null
        cpus   = 1
        memory = '2.GB'
    }

    // ---- Read QC ----
    withName: 'FASTP' {
        conda = null
        cpus     = 2
        memory   = '8.GB'
        maxForks = 3
    }

    // ---- Assembly ----
    withName: 'SKESA' {
        container = null
        cpus     = 2
        memory   = '8.GB'
        maxForks = 3
    }

    // ---- Assembly QC ----
    withName: 'BUSCO_BUSCO' {
        conda = null
        cpus     = 2
        memory   = '8.GB'
        maxForks = 3
    }

    withName: 'QUAST' {
        conda = null
        cpus = 1
        memory = '4.GB'
        maxForks = 6
    }

    // ---- Antimicrobial resistance ----
    withName: 'RGI_CARDANNOTATION' {
        conda = null
        cpus = 1
        memory = '4.GB'
    }

    withName: 'RGI_MAIN' {
        conda = null
        cpus = 2
        memory = '8.GB'
        maxForks = 3
    }

    // ---- Phylogeny ----
    withName: 'PARSNP' {
        conda = null
        cpus = 3
        memory = '8.GB'
    }

    // ---- R plotting ----
    withName: 'R_PLOT' {
        container = null
        cpus = 6
        memory = '24.GB'
    }

    // ---- MultiQC Report ----
    withName: 'MULTIQC' {
        conda = null
        cpus = 1
        memory = '4.GB'
    }
    
}
/*
 * modules.config
 * Per-process settings that describe the pipeline: ext.args, container/conda
 * overrides and where each process publishes its results.
 * Resources (cpus, memory) live in base.config.
 */

process {

    // ---- SRA download (subworkflow: FASTQ_DOWNLOAD_PREFETCH_FASTERQDUMP_SRATOOLS) ----
    withName: 'SRATOOLS_FASTERQDUMP' {
        conda = null

        // Downloaded FASTQs are copied into the input directory so the next run finds them
        publishDir = [
            path: { params.input_dir },
            mode: 'copy',
            pattern: '*.fastq.gz'
        ]
    }

    // ---- Read QC ----
    withName: 'FASTP' {
        conda = null

        ext.args   = [
            '--qualified_quality_phred 20',
            '--length_required 50',
            '--n_base_limit 5',
            '--average_qual 20',
            '--detect_adapter_for_pe',
            '--low_complexity_filter',
            '--complexity_threshold 30',
        ].join(' ')

        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: 'copy'
        ]
    }

    // ---- Assembly ----
    withName: 'SKESA' {
        container  = null

        ext.args = [
            '--kmer 21',
            '--vector_percent 1',
        ].join(' ')

        publishDir = [
            path: { "${params.outdir}/skesa" },
            mode: 'copy'
        ]
    }

    // ---- Assembly QC ----
    withName: 'BUSCO_DOWNLOAD' {
        conda = null

        publishDir = [
            path: { params.databases },
            mode: 'copy'
        ]
    }

    withName: 'BUSCO_BUSCO' {
        conda = null

        ext.args   = [
            '--mode genome',
        ].join(' ')
        
        publishDir = [
            path: { "${params.outdir}/busco" },
            mode: 'copy'
        ]
    }

    withName: 'QUAST' {
        conda = null
        
        ext.args = [
            '--min-contig 200',
            '--x-for-Nx 90'
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: 'copy'
        ]
    }

    // ---- Antimicrobial resistance ----
    withName: 'RGI_DOWNLOADDB' {
        conda = null

        publishDir = [
            path: { params.databases },
            mode: 'copy'
        ]
    }

    withName: 'RGI_MAIN' {
        conda = null

        ext.args2 = [
            '--low_quality',
        ].join(' ')

        publishDir = [
            path: { "${params.outdir}/card_rgi" },
            mode: 'copy'
        ]
    }

    // ---- Phylogeny ----
    withName: 'PARSNP' {
        conda      = null

        publishDir = [
            path: { "${params.outdir}/parsnp" },
            mode: 'copy'
        ]
    }

    // ---- Reporting ----
    withName: 'MULTIQC' {
        conda = null

        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy'
        ]
    }

    withName: 'R_PLOT' {
        container = null

        publishDir = [
            path: { "${params.outdir}/r_plots" },
            mode: 'copy'
        ]
    }
}
/*
 * nextflow.config
 * Entry point: parameters, profiles and includes for the other config files.
 */
 
// ---- Parameters ----
params {
    // Inputs
    input_dir  = 'inputs'          // FASTQs are read from here; SRA downloads are copied here
    input_csv = 'assets/samplesheet.csv'
    ref_genome = 'assets/vcho_ref_all.fasta'             // reference genome FASTA for QUAST (required)
    ref_gff    = 'assets/vcho_ref_all.gff'            // reference annotation GFF for QUAST (required)
 
    // Outputs
    outdir     = 'results'
    databases  = 'databases'      // BUSCO and CARD databases are stored here

    // other
    BUSCO_db = 'vibrionales_odb10'

}
 
// ---- Process configuration ----
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
 
// ---- Profiles ----
profiles {
    standard {
        docker.enabled      = true
        conda.enabled       = true
    }
}
 
// ---- Run reports ----
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
 
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
 
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
 
// ---- Manifest ----
manifest {
    name            = 'V_cho_pipeline'
    description     = 'Assembly, QC, AMR and phylogeny pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
}
 